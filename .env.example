# ── Cloudinary (upload d'images sur le canvas) ──────────────────────────────
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=ton_nom_cloudinary
CLOUDINARY_API_KEY=ta_cle_API
CLOUDINARY_API_SECRET=ta_cle_secrete
CLOUDINARY_UPLOAD_PRESET=CakeJDR-DU6-image

# ── Liveblocks (collaboration temps réel) ────────────────────────────────────
# Secret key Liveblocks (commence par sk_prod_ ou sk_dev_)
LIVEBLOCKS_SECRET_KEY=sk_liveblocks_example


# ── Debug (optionnel) ────────────────────────────────────────────────────────
# Mettre à "1" pour activer les logs [debug] dans la console navigateur et serveur
NEXT_PUBLIC_DEBUG=0

# -- Admin (panel /admin) ----------------------------------------------------
# Mot de passe unique donnant acces au panel d'administration.
# Ne JAMAIS prefixer par NEXT_PUBLIC_ : la valeur serait embarquee dans le bundle.
ADMIN_PASSWORD=change-moi-par-un-mot-de-passe-long
# Cle de signature du cookie de session admin.
# Generer avec :  openssl rand -hex 32   (ou  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_SESSION_SECRET=change-moi-32-octets-hex

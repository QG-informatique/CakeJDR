# ── Cloudinary (upload d'images sur le canvas) ──────────────────────────────
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=ton_nom_cloudinary
CLOUDINARY_API_KEY=ta_cle_API
CLOUDINARY_API_SECRET=ta_cle_secrete
CLOUDINARY_UPLOAD_PRESET=CakeJDR-DU6-image

# ── Liveblocks (collaboration temps réel) ────────────────────────────────────
# Secret key Liveblocks (commence par sk_prod_ ou sk_dev_)
LIVEBLOCKS_SECRET_KEY=sk_liveblocks_example


# ── Debug (optionnel) ────────────────────────────────────────────────────────
# Mettre à "1" pour activer les logs [debug] dans la console navigateur et serveur
NEXT_PUBLIC_DEBUG=0

# -- Base de donnees (Neon) ----------------------------------------------------
DATABASE_URL=
# Cle de l'appel quotidien de remise a zero de la salle de demonstration
CRON_SECRET=

# -- Connexion (Auth.js : Google et Discord) ----------------------------------
# Cle de signature des sessions.
# Generer avec :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Google Cloud Console > API et services > Identifiants > ID client OAuth
# URI de redirection : <adresse du site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Discord Developer Portal > Applications > OAuth2
# Redirection : <adresse du site>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
